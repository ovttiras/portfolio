# Скопируйте в rag/.env и заполните. Файл .env не попадает в git.

# --- Google AI Studio (Gemini API): https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- LLM
LLM_PROVIDER=google
LLM_MODEL=gemini-3.1-flash-lite
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# --- Эмбеддинги (после смены модели переиндексируйте: python -m app.ingest)
EMBEDDINGS_PROVIDER=google
EMBEDDINGS_MODEL=gemini-embedding-001
EMBEDDINGS_DIM=768

# --- Альтернатива 1: LLM через OpenAI-совместимый API (pip install langchain-openai)
# LLM_PROVIDER=openai
# LLM_MODEL=llama-3.3-70b-versatile
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=

# --- Альтернатива 2: локальные эмбеддинги без API
# (pip install langchain-huggingface sentence-transformers)
# EMBEDDINGS_PROVIDER=huggingface
# EMBEDDINGS_MODEL=intfloat/multilingual-e5-small

# --- Источники блога (через запятую)
# BLOG_DIR=data/blog
# BLOG_FEED_URLS=https://medium.com/feed/@username,https://habr.com/ru/rss/users/username/publications/articles/
# BLOG_PAGE_URLS=https://example.com/my-post-1,https://example.com/my-post-2
SITE_URL=https://ovttiras.github.io/portfolio/

# --- API
ALLOWED_ORIGINS=https://ovttiras.github.io,http://localhost:5500,http://127.0.0.1:5500
RATE_LIMIT_PER_MINUTE=10
